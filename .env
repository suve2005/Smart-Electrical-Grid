# Firebase Configuration (mock - replace with real Firebase project)
FIREBASE_API_KEY=mock_api_key_for_development_only
FIREBASE_AUTH_DOMAIN=mock-project.firebaseapp.com
FIREBASE_PROJECT_ID=mock-project-123
FIREBASE_STORAGE_BUCKET=mock-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost/smart_grid

# Security Configuration
SECRET_KEY=change-this-in-production-for-real-secret
ALGORITHM=PBKDF2
PBKDF2_ITERATIONS=100000
SALT_BYTES=16
HASH_FORMAT=salted_base64  # Format: base64_salt:base64_hash

# Application Settings
DEBUG=True
ENVIRONMENT=development