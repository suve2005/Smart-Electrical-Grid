# PostgreSQL (local Docker Compose mapping)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=smart_grid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_local_password

# Firebase web project
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# Firebase Admin SDK service-account JSON path (keep the file out of Git).
# Relative paths are resolved from the repository root.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Security
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=PBKDF2
PBKDF2_ITERATIONS=100000
SALT_BYTES=16

# Application
DEBUG=true
ENVIRONMENT=development

# Frontend development origins (VS Code Live Server normally uses port 5500).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
